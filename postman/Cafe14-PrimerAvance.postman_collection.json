  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (![\"GET\", \"HEAD\"].includes(pm.request.method)) {",
          "  pm.sendRequest(pm.variables.get(\"baseUrl\") + \"/api/auth/csrf\", (err, res) => {",
          "    if (!err && res.code === 200) pm.request.headers.upsert({key:\"X-XSRF-TOKEN\",value:res.json().token});",
          "  });",
          "}"
        ]
      }
    }
  ]
}