{
  "info": {
    "name": "Café Catorce - Avance 4.3",
    "description": "CRUD de Secciones, Productos y Mesas. Backend Spring Boot, datos en memoria (sin base de datos). Base URL en la variable {{baseUrl}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
