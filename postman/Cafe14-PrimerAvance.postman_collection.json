  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login administrador local",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"admin@cafecatorce.local\", \"clave\": \"Cafe14.Local!2026\"}"
            }
          }
        },
        {
          "name": "Mi perfil",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Cerrar sesión",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/logout"
          }
        }
      ]
    },
